{
  "name": "MTR zone transitions retire obsolete count buckets",
  "configuration": {
    "schema_version": 1,
    "areas": {"alpha": "ground", "beta": "ground"},
    "adjacency": {},
    "identities": {},
    "cameras": {},
    "sources": [
      {
        "source_id": "radar_a", "adapter": "mtr_count", "floor": "ground",
        "entity_ids": ["sensor.radar_total", "sensor.radar_zone_a", "sensor.radar_zone_b", "sensor.radar_zone_c"],
        "options": {"total_entity_id": "sensor.radar_total", "zone_areas": {"sensor.radar_zone_a": "alpha", "sensor.radar_zone_b": "alpha", "sensor.radar_zone_c": "beta"}}
      }
    ]
  },
  "steps": [
    {"at": 0, "channel_type": "state", "channel": "sensor.radar_total", "payload": {"state": "1"}},
    {"at": 0, "channel_type": "state", "channel": "sensor.radar_zone_a", "payload": {"state": "0"}},
    {"at": 0, "channel_type": "state", "channel": "sensor.radar_zone_b", "payload": {"state": "0"}},
    {"at": 0, "channel_type": "state", "channel": "sensor.radar_zone_c", "payload": {"state": "0"}, "expect": {"count": [1, 1]}},
    {"at": 1, "channel_type": "state", "channel": "sensor.radar_zone_a", "payload": {"state": "1"}, "expect": {"count": [1, 1], "presence": {"kind": "unknown_living", "area": "alpha"}}},
    {"at": 2, "channel_type": "state", "channel": "sensor.radar_zone_c", "payload": {"state": "1"}, "expect": {"count": [1, 1]}},
    {"at": 3, "channel_type": "state", "channel": "sensor.radar_zone_c", "payload": {"state": "0"}, "expect": {"count": [1, 1], "presence": {"kind": "unknown_living", "area": "alpha"}}},
    {"at": 3, "channel_type": "state", "channel": "sensor.radar_zone_c", "payload": {"state": "0"}, "expect": {"count": [1, 1], "changed": false}},
    {"at": 4, "channel_type": "state", "channel": "sensor.radar_zone_a", "payload": {"state": "0"}, "expect": {"count": [1, 1]}},
    {"at": 5, "channel_type": "state", "channel": "sensor.radar_total", "payload": {"state": "0"}, "expect": {"count": [0, 0]}},
    {"at": 6, "channel_type": "state", "channel": "sensor.radar_total", "payload": {"state": "2"}, "expect": {"count": [2, 2]}},
    {"at": 7, "channel_type": "state", "channel": "sensor.radar_zone_b", "payload": {"state": "1"}, "expect": {"count": [2, 2]}},
    {"at": 7, "channel_type": "state", "channel": "sensor.radar_zone_c", "payload": {"state": "1"}, "expect": {"count": [2, 2]}},
    {"at": 8, "channel_type": "state", "channel": "sensor.radar_zone_b", "payload": {"state": "0"}, "expect": {"count": [2, 2]}},
    {"at": 8, "channel_type": "state", "channel": "sensor.radar_zone_c", "payload": {"state": "0"}, "expect": {"count": [2, 2]}},
    {"at": 8, "channel_type": "state", "channel": "sensor.radar_total", "payload": {"state": "0"}, "expect": {"count": [0, 0]}}
  ]
}
